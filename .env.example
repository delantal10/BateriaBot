# BateriaBot — variables de entorno
#
# MercadoLibre: usamos el flujo Client Credentials (token automático, no expira entre runs).
# Encontrás estos valores en la sección "Credenciales" de tu app en developers.mercadolibre.com.ar
#
ML_APP_ID=tu-app-id-aqui
ML_CLIENT_SECRET=tu-client-secret-aqui

# Ruta de la base de datos (por defecto: baterias.db en el directorio del proyecto)
# DB_PATH=/ruta/absoluta/baterias.db
