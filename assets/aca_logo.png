		<style type="text/css" id="wp-custom-css">
			/* =========================================================
   LOGO FIA - (DESKTOP + TABLET + MOBILE)
   Implementa AS 01-2026
========================================================= */

/* -------- DESKTOP -------- */
nav,
.main-nav,
.nz-main-navigation{
  position: relative !important;
  overflow: visible !important;
}

nav > ul,
.main-nav > ul,
.nz-main-navigation > ul{
  padding-right: 110px !important;
}

/* Logo FIA solo en navegación principal del header */
header nav::after,
#header nav::after,
.main-nav::after,
.nz-main-navigation::after{
  content: '';
  position: absolute;
  right: 10px;
  top: 50%;
  transform: translateY(-50%);
  width: 90px;
  height: 45px;

  background-image: url('/wp-content/uploads/2026/01/logo-fia-member.png');
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;

  z-index: 999999;
  pointer-events: none;
}

/* Evitar que aparezca en navegación de posts / entradas */
.post-navigation::after,
.post-navigation nav::after,
nav.post-navigation::after,
.posts-navigation::after,
.posts-navigation nav::after,
nav.posts-navigation::after,
.pagination::after,
.navigation.pagination::after,
.navigation.post-navigation::after,
article nav::after,
footer nav::after{
  content: none !important;
  display: none !important;
}

/* -------- TABLET -------- */
@media (min-width: 769px) and (max-width: 1024px){

  /* En tablet el menú ya suele ser hamburguesa */
  nav::after,
  .main-nav::after,
  .nz-main-navigation::after{
    display: none !important;
    content: none !important;
  }

  /* Mantener oculto en navegación de posts */
  .post-navigation::after,
  .posts-navigation::after,
  .pagination::after,
  .navigation.pagination::after,
  .navigation.post-navigation::after{
    content: none !important;
    display: none !important;
  }

  /* Header tablet */
  .mob-header-top .container{
    position: relative !important;
    overflow: visible !important;
  }

  /* Logo FIA en tablet: a la izquierda del menú desplegable */
  .mob-header-top .container::after{
    content: '';
    position: absolute;

    right: 55px;
    top: 50%;
    transform: translateY(-50%);

    width: 70px;
    height: 70px;

    background-image: url('/wp-content/uploads/2026/01/logo-fia-member.png');
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;

    z-index: 999999;
    pointer-events: none;
  }
}

/* -------- MOBILE -------- */
@media (max-width: 768px){

  /* En mobile: NO en el nav (porque es el panel hamburguesa) */
  nav::after,
  .main-nav::after,
  .nz-main-navigation::after{
    display: none !important;
    content: none !important;
  }

  nav > ul,
  .main-nav > ul,
  .nz-main-navigation > ul{
    padding-right: 0 !important;
  }

  /* Mantener oculto en navegación de posts */
  .post-navigation::after,
  .posts-navigation::after,
  .pagination::after,
  .navigation.pagination::after,
  .navigation.post-navigation::after{
    content: none !important;
    display: none !important;
  }

  /* Contenedor real del header mobile */
  .mob-header-top .container{
    position: relative !important;
    overflow: visible !important;
  }

  /* FIA en el header mobile: a la izquierda del menú desplegable */
  .mob-header-top .container::after{
    content: '';
    position: absolute;

    right: 50px;
    top: 50%;
    transform: translateY(-50%);

    width: 60px;
    height: 60px;

    background-image: url('/wp-content/uploads/2026/01/logo-fia-member.png');
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;

    z-index: 999999;
    pointer-events: none;
  }
}

/*=========================================================
   ESTILO PARA POPUP DEL HOME
Implementa AS 01-2026
========================================================= */
.pum-container .pum-content .aca-alert-popup{
  box-sizing:border-box;
  font-family:'Open Sans', Arial, Helvetica, sans-serif;
  background:#f1f1f1;
  text-align:center;
  position:relative;
  padding:60px 35px 35px;
}
 
/* Título flotante */
 
.pum-container .pum-content .aca-popup-header{
  position:absolute;
  top:-28px;
  left:50%;
  transform:translateX(-50%);
  background:#ff0000;
  color:#fff;
  padding:14px 40px;
  font-size:26px;
  font-weight:700;
  white-space:nowrap;
}
 
/* Texto */
 
.pum-container .pum-content .aca-alert-popup p{
  margin:0 0 18px !important;
  font-size:16px;
  color:#202020;
  line-height:1.5;
}
 
/* Destacado */
 
.pum-container .pum-content .aca-highlight{
  font-size:17px;
  font-weight:600;
}
 
/* Bloques de contacto */
 
.pum-container .pum-content .aca-contact-item{
  margin:0 0 14px;
  font-size:16px;
}
 
/* Links */
 
.pum-container .pum-content .aca-alert-popup a{
  color:#000;
  text-decoration:none;
  font-weight:600;
}
 
.pum-container .pum-content .aca-alert-popup a:hover{
  text-decoration:underline;
}
 
/* Footer */
 
.pum-container .pum-content .aca-footer-text{
  margin-top:25px !important;
  font-weight:600;
}
 
.pum-container .pum-content .aca-thanks{
  margin-top:15px !important;
  font-weight:600;
}
 


/*=========================================================
   ESTILO PARA POPUP DE AUXILIO
Implementa AS 02-2026
========================================================= */

.pum-container .pum-content .aca-alert-popup{
  box-sizing:border-box;
  font-family:'Open Sans', Arial, Helvetica, sans-serif;
  background:#f1f1f1;
  text-align:center;
  position:relative;
  padding:50px 30px 30px;
}

/* Título flotante */
.pum-container .pum-content .aca-popup-header{
  position:absolute;
  top:-28px;
  left:50%;
  transform:translateX(-50%);
  background:#ff0000;
  color:#fff;
  padding:14px 40px;
  font-size:26px;
  font-weight:700;
  white-space:nowrap;
}

/* Texto */
.pum-container .pum-content .aca-alert-popup p{
  margin:0 0 18px !important;
  font-size:16px;
  color:#202020;
  line-height:1.5;
}

.pum-container .pum-content .aca-highlight{
  font-size:17px;
  font-weight:600;
}

.pum-container .pum-content .aca-contact-item{
  margin:0 0 14px;
  font-size:16px;
}

.pum-container .pum-content .aca-alert-popup a{
  color:#000;
  text-decoration:none;
  font-weight:600;
}
.pum-container .pum-content .aca-alert-popup a:hover{
  text-decoration:underline;
}

.pum-container .pum-content .aca-footer-text{
  margin-top:25px !important;
  font-weight:600;
}

.pum-container .pum-content .aca-thanks{
  margin-top:15px !important;
  font-weight:600;
}

/* Opcional: que el popup tenga buen ancho */
#pum-XXXX{
  max-width:650px;
  width:90%;
}

/* Bloque de imágenes */
.pum-container .pum-content .aca-images{
  display:flex;
  justify-content:center;
  align-items:center;
  gap:40px;
  margin-top:20px;
}
 
/* Contenedores de imagen */
.pum-container .pum-content .aca-image-item{
  width:160px;
  height:160px;
  display:flex;
  align-items:center;
  justify-content:center;
}
 
/* Imágenes */
.pum-container .pum-content .aca-image-item img{
  max-width:100%;
  max-height:100%;
  object-fit:contain;
  display:block;
}





		</style>
